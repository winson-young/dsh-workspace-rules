{
  "name": "dsh-workspace-rules",
  "version": "0.1.3",
  "description": "按工作区管理 DSH 项目私有指令（CLAUDE.local.md），带设置面板",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "rules",
    "instructions",
    "agents",
    "workspace"
  ],
  "license": "MIT",
  "author": "winson-young",
  "homepage": "https://github.com/winson-young/dsh-workspace-rules#readme",
  "bugs": {
    "url": "https://github.com/winson-young/dsh-workspace-rules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winson-young/dsh-workspace-rules.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible"
      }
    }
  }
}
